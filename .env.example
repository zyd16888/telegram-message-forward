# Docker Compose 示例环境变量。复制为 .env 后按实际部署修改。

# Web 访问端口。
TMF_HTTP_PORT=8080

# PostgreSQL 线上库 DSN。
TMF_DATABASE_DSN=postgres://tmf:CHANGE_ME_DB_PASSWORD@db.example.com:5432/telegram_forward?sslmode=require

# 首次启动空库时建议为 true；已有库或生产环境希望手动迁移时可改为 false。
TMF_DATABASE_AUTO_MIGRATE=true

# 32 字节加密主密钥。存入 Telegram session 或 secret 后不要再修改。
TMF_SECURITY_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_LONG_KEY_0000

TMF_SECURITY_AUTH_ENABLED=true
TMF_LOG_LEVEL=info
TMF_LOG_FORMAT=text
TMF_DISPATCH_WORKER_COUNT=2
TMF_DISPATCH_POLL_INTERVAL=2s
TMF_DISPATCH_VISIBILITY_TIMEOUT=5m
TMF_DISPATCH_MAX_ATTEMPTS=3
